 BILD BEZ "CSM BA 160 Stab 3079 x= 0.00 launching s 242[m]"
 LF 7160 ENR #N x #x
        QUER TYP SIG ETYP STAB RTYP NONL SCHR 0.25 DARS DLIN FILL NEIN $ UNIT #AQUP_sig $ 1 cm = ... N/mm2
  und ; QUER TYP BWS ETYP STAB RTYP NONL SCHR 0.25 DARS DLIN FILL NEIN UNIT #AQUP_sss $ Betonstahlspannungen
 BILD BEZ "CSM BA 200 Stab 3079 x= 0.00 remove launching nose"
 LF 7200 ENR #N x #x
        QUER TYP SIG ETYP STAB RTYP NONL SCHR 0.25 DARS DLIN FILL NEIN $ UNIT #AQUP_sig $ 1 cm = ... N/mm2
  und ; QUER TYP BWS ETYP STAB RTYP NONL SCHR 0.25 DARS DLIN FILL NEIN UNIT #AQUP_sss $ Betonstahlspannungen
 BILD BEZ "CSM BA 210 Stab 3079 x= 0.00 additional G_2"
 LF 7210 ENR #N x #x
        QUER TYP SIG ETYP STAB RTYP NONL SCHR 0.25 DARS DLIN FILL NEIN $ UNIT #AQUP_sig $ 1 cm = ... N/mm2
  und ; QUER TYP BWS ETYP STAB RTYP NONL SCHR 0.25 DARS DLIN FILL NEIN UNIT #AQUP_sss $ Betonstahlspannungen
ENDE
$
