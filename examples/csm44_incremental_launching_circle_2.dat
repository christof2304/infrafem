sto#node(6) #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(7.00) TYP 'S' GRP 9 NRQ 1.101 SPT #spt  $ start main bridge excess  at #S_XI(7)
sto#node(7) #spt
sto#grpcs(9) #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(7.10) TYP 'S' GRP 9 NRQ 102.102 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(7.20) TYP 'S' GRP 9 NRQ 103.103 SPT #spt
