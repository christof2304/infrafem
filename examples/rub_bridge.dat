$ MESH TOPOLOGY (0 = HYBRID HEXAEDER MESH WITH BOUNDARY LAYER
$               (1 = POLYHEDRA MESH BASED ON TRINAGULAR MESH
#DEFINE MESH=1

$ ANGLE OF ATTACK
#DEFINE ALF=+4.0

+PROG AQUA urs:1
HEAD WIND PRESSURE BRIDGE DECK IN WIND TUNNEL
NORM EN 1993-2005 UNIT 7 ; MATE 1 TYPE AIR
END

+PROG SOFIMSHC urs:2
HEAD WIND PRESSURE BRIDGE DECK IN WIND TUNNEL
SYST WFRA GDIR NEGY GDIV 0
GRP  0 BASE       0 TITL 'AIR'
GRP  1 BASE  110000 TITL 'Inflow'
GRP  2 BASE  120000 TITL 'Outflow'
GRP  3 BASE  130000 TITL 'Bridge'
STO#ALF $(ALF) $ ANGLE OF ATTACK
STO#H    66.6,40.0,26.6  $ HEIGHT OF SECTION
STO#B    366,284,206     $ WIDTH OF SECTION
STO#SC   35.20           $ HEIGHT OF SHEAR CENTER
STO#L  -12.0*#H,15*#B    $ EXTEND OF REGION
STO#MESH $(MESH)
IF #MESH
  STO#S   50.0,2.0         $ MESH SIZE PARAMETERS Y+ > 2.7 MIN(d/B=0.0015)
  STO#S   80.0,4.0         $ COARSE MESH SIZE PARAMETERS Y+ > 28
  STO#S   50.0,1.0         $ MESH SIZE PARAMETERS Y+ > 2.7 MIN(d/B=0.0015)
ELSE
  STO#S   50.0,2,0.6       $ MESH SIZE PARAMETERS Y+ > 2.7 MIN(d/B=0.0015)
  STO#S   80.0,6.0,4.0     $ COARSE MESH SIZE PARAMETERS Y+ > 28
ENDIF

$ THE OUTER BOUNDS
SPT 901 #L(0) -15.5*#H ; 903 #L(1) ==
SPT 902 #L(0) +15.5*#H ; 904 #L(1) ==
SLN 1 901 902 TITL 'INTAKE'   GRP 1
    2 903 904 TITL 'OUTTAKE'  GRP 2
    3 901 903 ; 4 902 904

$ THE BRIDGE DECK COORDINATES
LET#X(10) 0.0      ; LET#Y(10)   0.0
LET#X(1) -#B(1)/2  ; LET#Y(1)   #H-#SC
LET#X(2) -#B(0)/2  ; LET#Y(2)   #Y(1)-#H(2)
LET#X(3) -#B(2)/2  ; LET#Y(3)   #Y(2)-#H(1)
LET#X(4)  #B(2)/2  ; LET#Y(4)   #Y(3)
LET#X(5)  #B(0)/2  ; LET#Y(5)   #Y(2)
LET#X(6)  #B(1)/2  ; LET#Y(6)   #Y(1)

LET#CAL COS(#ALF) ; LET#SAL SIN(-#ALF) $ ANGLE ROTATING ABOUT +Z
$ THE SEQUENCE OF THE NODES HAS TO BE IN THAT WAY THAT THE TRANSVERSE
$ DIRECTION (-SY,SX) IS INWARDS, SO THAT A POSITIVE PRESSURE WILL CREATE
$ FORCES IN THAT DIRECTION
LOOP#1 6
  SPT 101+#1 #X(#1+1)*#CAL-#Y(#1+1)*#SAL #Y(#1+1)*#CAL+#X(#1+1)*#SAL
ENDLOOP
$ PRESSURE TAPS, SHIFTED BY NUMBER OF 10
LOOP#1 5 ; LET#F (10+9*#1)/49
  LET#X (1-#F)*(#X(2))+#F*(#X(1))
  LET#Y (1-#F)*(#Y(2))+#F*(#Y(1))
  SPT 1+#1 #X*#CAL-#Y*#SAL +#Y*#CAL+#X*#SAL
ENDLOOP
LOOP#1 13; LET#F (4+23*#1)/284
  LET#X (1-#F)*(#X(1))+#F*(#X(6)) ; LET#Y #Y(1)
  SPT 6+#1 #X*#CAL-#Y*#SAL +#Y*#CAL+#X*#SAL
ENDLOOP
LOOP#1 3 ; LET#F (3+18*#1)/49
  LET#X (1-#F)*(#X(6))+#F*(#X(5))
  LET#Y (1-#F)*(#Y(6))+#F*(#Y(5))
  SPT 19+#1 #X*#CAL-#Y*#SAL +#Y*#CAL+#X*#SAL
ENDLOOP
LOOP#1 4 ; LET#F (10+25*#1)/89
  LET#X (1-#F)*(#X(5))+#F*(#X(4))
  LET#Y (1-#F)*(#Y(5))+#F*(#Y(4))
  SPT 22+#1 #X*#CAL-#Y*#SAL +#Y*#CAL+#X*#SAL
ENDLOOP
LOOP#1 8 ; LET#F (4+28*#1)/206
  LET#X (1-#F)*(#X(4))+#F*(#X(3)) ; LET#Y #Y(4)
  SPT 26+#1 #X*#CAL-#Y*#SAL +#Y*#CAL+#X*#SAL
ENDLOOP
LOOP#1 7 ; LET#F (5+12.5*#1)/89
  LET#X (1-#F)*(#X(3))+#F*(#X(2))
  LET#Y (1-#F)*(#Y(3))+#F*(#Y(2))
  SPT 34+#1 #X*#CAL-#Y*#SAL +#Y*#CAL+#X*#SAL
ENDLOOP
LOOP#1 6
  SLN 11+#1 101+#1 101+MOD(#1+1,6) SDIV #S(1) GRP 3
ENDLOOP

$ CREATE A HYBRID MESH WITH 8 ELEMENTS FOR THE STRUCTURED BOUNDARY LAYER
$ COMMENT H3 and DFIX DEFINITIONS FOR A TRUE UNSTRUCTURED GRID
IF #MESH
    SAR 1 MNO 1 GRP 0 T 0
    SARB AUS 1,2,3,4
    SARB IN (11 16 1)
    CTRL MESH 2+32
ELSE
    SAR 1 MNO 1 GRP 0 T 0 H3 #S(2)
    SARB AUS 1,2,3,4
    SARB IN (11 16 1) DFIX 3*#S(2)
    CTRL MESH 2
ENDIF
CTRL HMIN #S(0) - 1.03
END

#IF $(MESH)==0
+PROG SOFIMSHA urs:3
HEAD Generate primary mesh geo-file
EXPO DOLG:PA $ USE THE HEXAEDER HYBRID MESH
END
#ELSE
+PROG SOFIMSHA urs:4
HEAD Generate dual mesh geo-file
EXPO DOL3     $ CREATE THE .CEL / .VRT
EXPO DOLG:DAT $ USE THE POLYEDER MESH, CREATE A VTK FILE
END
#ENDIF

$ Comparisson of pressures  for RUB Bridge-Section (ALF=0.0)
$ Pressure tap         Experiment openfoam     dolfyn     dolfyn
$                                    (sst)       (ke)      (RNG)
$ top spt 01 (tap 31)     0,494      0,650      0,723      0,689
$ top spt 05 (tap 35)    -0,413     -1,090     -0,676     -0,662
$ top spt 06 (tap 36)    -0,902     -1,230     -1,307     -1,181
$ top spt 18 (tap 8)     -0,202     -0,270     -0,216     -0,149
$ top spt 19 (tap 9)     -0,264     -0,260     -0,199     -0,135
$ top spt 21 (tap 11)    -0,270     -0,250     -0,133     -0,096
$ --
$ dwn spt 40 (tap 30)     0,496      0,670      0,779      0,799
$ dwn spt 34 (tap 24)    -0,708     -1,110     -0,730     -0,677
$ dwn spt 33 (tap 23)    -1,083     -1,250     -1,180     -1,065
$ dwn spt 26 (tap 16)    -0,295     -0,340     -0,335     -0,261
$ dwn spt 25 (tap 15)    -0,305     -0,300     -0,297     -0,218
$ dwn spt 22 (tap 12)    -0,303     -0,250     -0,133     -0,109

$ peak value nose                               1,194      1,190
$ peak value top bend                          -1,834     -1,683
$ peak value dwn bend                          -1,699     -1,500
$ -------------------------------------------------------------- DOLFYN (ke)  (RNG)
$ Total Drag   (alf=0.0)  0,088      0,073      0,093      0,081 NOSL: 0.078  0.069
$                         0,075                 0,081      0,069
$ ---------------------------------------------------------------------------------
$ Total Drag   (alf=4.0)  0,095      0,062      0,080      0,066 NOSL: 0.068  0.050
$ Total Lift   (alf=4.0)  0,380      0,300      0,345      0,448       0.243  0.391
$ Total Moment (alf=4.0)  0,109      0,100      0,115      0,125       0.110  0.113
$ =================================================================================
$ The pressure results are very sensitive to the mesh definition and the inflow!
$ with the polyhedral mesh (#H(1)=1mm) we have obtained:
$   L 30 mm   cd = 0.0571 ; cl = 0.2687 ; cm = 0.1478
$   L 20 mm   cd = 0.0482 ; cl = 0.3511 ; cm = 0.1205
$   L 10 mm   cd = 0.0518 ; cl = 0.2773 ; cm = 0.1505
$   L  5 mm   cd = 0.0543 ; cl = 0.3073 ; cm = 0.1580

+PROG DOLFYN urs:5
HEAD WIND ANALYSIS WITH STD K-EPS TURBULENCE MODEL
FLOW RHO 1.25 NUE 1.373E-05 TURB KE
LET#UI  5.0
$ moderate turbulence intensity, length scale honecomb
CASE 11 U #UI K 3[%] EPS 20[mm] PREF 903
IN   1  U #UI K 3[%] EPS 20[mm]
OUT  2
WALL 3  NOSL
WALL 0  SYMP
$ THE REFERENCE AREA IS IN UNIT 1M*1MM
DRAG #UI AX #B*1E-3 #B*1E-3 AXX #B**2*1E-6 W GRP 3 ALF $(ALF)
DOLF init steps 0
STEP 500 TOL 1.E-6
END

+PROG DOLFYN urs:6
HEAD WIND ANALYSIS WITH RNG TURBULENCE MODEL
FLOW RHO 1.25 NUE 1.373E-05 TURB RNG
LET#UI  5.0
$ moderate turbulence intensity, length scale honecomb
CASE 12 U #UI K 3[%] EPS 20[mm] PREF 903
IN   1  U #UI K 3[%] EPS 20[mm]
OUT  2
WALL 3  NOSL
WALL 0  SYMP
$ THE REFERENCE AREA IS IN UNIT 1M*1MM
DRAG #UI AX #B*1E-3 #B*1E-3 AXX #B**2*1E-6 W GRP 3 ALF $(ALF)
DOLF init steps 0
STEP 500 TOL 1.E-6
END

+PROG WING urs:7
HEAD
SIZE TYPE URS SC 0
VIEW TYPE DIRE X 0 Y 0 Z -1 AXIS NEGY ROTA 0
$
loop#lf 2
  LC   NO 11+#lf
  QUAD TYPE FL   UNIT DEFA SCHH NO STYP E2N FILL AREA REPR DISO AVER NO
  QUAD TYPE TE   UNIT DEFA SCHH NO STYP E2N FILL AREA REPR DISO AVER NO
  QUAD TYPE MUET UNIT DEFA SCHH NO STYP E2N FILL AREA REPR DISO AVER NO
endloop
$
loop#lf 2
  LC   NO 11+#lf
  COLO C20 -9006
  GRP  0,1,2 OFF
  GRP  3 YES BOUN
  SCHH H6 0.290000
  BOX XMIN -20. YMIN -8. XMAX 20 YMAX 8 TYPE BWIN OPER AND BGRP 0
  ARRO TYPE LINE FKIN NO
  LOAD TYPE WIND UNIT DEFA SCHH YES FILL NO REPR DLIN ETYP BOUN GTYP ELEM
endloop
END

-PROG DOLFYN urs:8
HEAD TRANSIENT WIND ANALYSIS (WITH A SMALLER LENGTH SCALE)
$ THERE IS NO KARMAN EFFECT
FLOW RHO 1.25 NUE 1.373E-05 TURB RNG
LET#UI  5.0
$ moderate turbulence intensity, length scale honecomb
CASE 100 U #UI K 3[%] EPS 10[mm] PREF 903
IN   1   U #UI K 3[%] EPS 10[mm]
OUT  2
WALL 3  NOSL $ 0.05[mm]
WALL 0  SYMP
$ THE REFERENCE AREA IS IN UNIT 1M*1MM
DRAG #UI AX #B*1E-3 #B*1E-3 AXX #B**2*1E-6 W GRP 3 ALF $(ALF)
HIST DRAG 3
DOLF init steps 0
STEP 200 0.025 INT 10

DOLF USE VTK ! BIN
DOLF post,u,cell,yes
DOLF post,v,cell,yes
DOLF post,p,cell,yes
DOLF post,k,cell,yes
DOLF post,eps,cell,yes


END
-PROG DYNR urs:9
head DRAG AND LIFT COEFFICIENTS
HIST 100 SPX,SPY 3 YMIN 0
end



