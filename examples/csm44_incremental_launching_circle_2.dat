let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(7.60) TYP 'S' GRP 9 NRQ 107.107 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(7.70) TYP 'S' GRP 9 NRQ 108.108 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(7.80) TYP 'S' GRP 9 NRQ 109.109 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(7.90) TYP 'S' GRP 9 NRQ 110.110 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(8.00) TYP 'S' GRP 9 NRQ 111.111 SPT #spt  $ end of launching nose
sto#node(8) #spt
sto#grpcs(10) #spt

GAXS 'AX_1' 'R' SPT 1000 Y  1450[mm] Z #zmax[mm] GRP 100  $ rigth Launching rail
GAXS 'AX_1' 'L' SPT 2000 Y -1450[mm] Z #zmax[mm] GRP 200  $ left  Launching rail

ENDE
$
+PROG SOFIMSHA urs:8
KOPF Launching rail, coupling beams, piers and springs
SYST REST ; STEU REST 2

KNOT 999 X 0[m] Y 0 $ center of circle to construct points

$ create counpling beams with sorrect group number :
GRUP 5 BEZ 'coupling beams 5'
  let#from #grpcs(5)   ; let#to #grpcs(4) ;   STAB - KA (#from #to 1)  KE (#from+1000 1) QNR 99
                                              STAB - KA (#from #to 1)  KE (#from+2000 1) QNR 99
                                              STAB - KA (#from+1000 #to+1000 1)  KE (#from+2000 1) QNR 98
GRUP 4 BEZ 'coupling beams 4'
  let#from #grpcs(4)+1 ; let#to #grpcs(3) ;   STAB - KA (#from #to 1)  KE (#from+1000 1) QNR 99
                                              STAB - KA (#from #to 1)  KE (#from+2000 1) QNR 99
                                              STAB - KA (#from+1000 #to+1000 1)  KE (#from+2000 1) QNR 98
GRUP 3 BEZ 'coupling beams 3'
  let#from #grpcs(3)+1 ; let#to #grpcs(2) ;   STAB - KA (#from #to 1)  KE (#from+1000 1) QNR 99
                                              STAB - KA (#from #to 1)  KE (#from+2000 1) QNR 99
                                              STAB - KA (#from+1000 #to+1000 1)  KE (#from+2000 1) QNR 98
GRUP 2 BEZ 'coupling beams 2'
  let#from #grpcs(2)+1 ; let#to #grpcs(1) ;   STAB - KA (#from #to 1)  KE (#from+1000 1) QNR 99
                                              STAB - KA (#from #to 1)  KE (#from+2000 1) QNR 99
                                              STAB - KA (#from+1000 #to+1000 1)  KE (#from+2000 1) QNR 98
GRUP 1 BEZ 'coupling beams 1'
  let#from #grpcs(1)+1 ; let#to #grpcs(9) ;   STAB - KA (#from #to 1)  KE (#from+1000 1) QNR 99
                                              STAB - KA (#from #to 1)  KE (#from+2000 1) QNR 99
                                              STAB - KA (#from+1000 #to+1000 1)  KE (#from+2000 1) QNR 98
GRUP 9 BEZ 'coupling beams 9'
  let#from #grpcs(9)+1 ; let#to #grpcs(10);   STAB - KA (#from #to 1)  KE (#from+1000 1) QNR 99
                                              STAB - KA (#from #to 1)  KE (#from+2000 1) QNR 99
                                              STAB - KA (#from+1000 #to+1000 1)  KE (#from+2000 1) QNR 98

$ change section right and left to Launching rail cestion 98:
STAB prop QNR 97
MOD STAB VON 100000 BIS 110000
MOD STAB VON 200000 BIS 210000

sto#dzmovs 0.50 $ moving spring height - not too short !
sto#dhmovs 2.00 $ horizontal movs distance
$
$
$
$                          * SPT main bridge
$                         / \
$                        /   \    right rail
$                       /     \   SPT+1000
$                      /       \ /
$  left rail SPT+2000 *         *--MOVS-HOR---* SPT+7000 horizontal movs node (coupled to SPT+3000)
$                                     GRP 13
$                     ^         ^
$    GRP 11 MOVS-left |         |  MOVS-right GRP 12
$                     |         |
$           SPT+4000 |*|       |*| SPT+3000   ---- top    of pier
$                    | |       | |
$                    | |       | |
$                    | |       | |
$                    | |       | |
$                    | |       | |
$                    | |       | |
$           SPT+6000 |*|       |*| SPT+5000   ---- bottom of pier
$

$ create piers including moving springs:
sto#no 1 ; let#spt #node(1) ; let#heigth 3.50
#define pier
  TRAN KNOT #spt+2000 DZ #dzmovs+#heigth[m] DNR 4000 ; KNOT #spt+2000+4000 FIX F $ bottom of pier left
  TRAN KNOT #spt+2000 DZ #dzmovs[m]         DNR 2000                             $ top    of pier
  TRAN KNOT #spt+1000 DZ #dzmovs+#heigth[m] DNR 4000 ; KNOT #spt+1000+4000 FIX F $ bottom of pier right
  TRAN KNOT #spt+1000 DZ #dzmovs[m]         DNR 2000                             $ top    of pier
  KNOT #spt+7000 NR1 #spt+1000 NR2 999 NR3 'S' X #dhmovs[m]                      $ horizontal movs node
  GRUP 0 ; STAB - KA #spt+1000+4000 KE #spt+1000+2000 QNR 91 $ pier left
          STAB - KA #spt+2000+4000 KE #spt+2000+2000 QNR 91 $ pier right
  GRUP 11 ; FEDE #no KA #spt+1000+2000 DZ -1 CP 1E6          $ main vertical moving spring left
  GRUP 12 ; FEDE #no KA #spt+2000+2000 DZ -1 CP 1E6          $ main vertical moving spring rigth
  GRUP 13 ; FEDE #no KA #spt+7000 KE #spt+1000 CP 1E3        $ main horizontal moving spring - weak , because rail is a polygon !!!!
  KNOT #spt+7000 NR1 #spt+3000 FIX KF
#enddef
#include pier
sto#no 2 ; let#spt #node(2) ; let#heigth 6.50
#include pier
sto#no 3 ; let#spt #node(3) ; let#heigth 7.50
#include pier
sto#no 4 ; let#spt #node(4) ; let#heigth 8.50
#include pier
sto#no 5 ; let#spt #node(5) ; let#heigth 6.50
#include pier
sto#no 6 ; let#spt #node(6) ; let#heigth 3.50
#include pier


$ create supports in launching bed:
loop#i0 #nbed $ number of nodes in launching bed
  let#i1 #i0+1
  sto#no #no+1 ; let#spt #i1 ; let#heigth 1.00
    #include pier
endloop

$ create longitudinal moving spring - only at some points:
GRUP 14
sto#nlong 1 ; let#spt #node(1) ; let#phi 50/#r*180/3.1416 $ at 1. pier (50m)
  FEDE #nlong KA #spt+3000 DX cos(#phi) DY sin(#phi) CP 1E5        $ longitudinal moving spring
sto#nlong 2 ; let#spt 11       ; let#phi 20/#r*180/3.1416   $ 20 m inside launching bed (in case of first stage not yet reached 1. pier)
  FEDE #nlong KA #spt+3000 DX cos(#phi) DY sin(#phi) CP 1E3        $ longitudinal moving spring in launching bed

$ Gruppenbezeichnung für WINGRAF:
GRUP 11 BEZ 'moving spring vertical left'
GRUP 12 BEZ 'moving spring vertical right'
GRUP 13 BEZ 'moving spring horizontal'
GRUP 14 BEZ 'moving spring longitudinal'

ENDE

+PROG AQUA URS:5
KOPF Create interpolated sections
INTE ALL
ENDE

!#!Kapitel Loading
+PROG SOFILOAD URS:4
KOPF Einwirkungen und Lasten
UNIT 5 $ Einheiten: Querschnitte in mm, Geometrie+Lasten in m
ACT G_1                                                              BEZ 'Ständige Lasten'
ACT G_2                                                              BEZ 'Ständige Lasten'
ACT P                                                            BEZ 'Vorspannung'
ACT C                                                                BEZ 'Kriechen+Schwinden'

LF 2 BEZ 'G_2'  TYP none
  STAB GRP 1,2,3,4,5 TYP PG PA 25
ENDE

+PROG ASE URS:6
KOPF Define Moving springs - Remain active up to next MOVS blank input
MOVS GRP 11 TYP BGRP VON 101 BIS 109 L0 #dzmovs[m]  ! main vertical moving spring left
MOVS GRP 12 TYP BGRP VON 201 BIS 209 L0 #dzmovs[m]  ! main vertical moving spring rigth

MOVS GRP 13 TYP BGRP VON 101 BIS 109 L0 #dhmovs[m]  ! horizontal    moving spring
MOVS GRP 14 TYP BGRP VON 101 BIS 109 L0 QUER  ! longitudinal stabilisation
$ L0 TRAN (L0 QUER)   defines a moving spring, that looks to the contact nodes
$ transvers to the dx,dy,dz direction of the spring !
ENDE

+PROG ASE URS:2
KOPF Test the system
GRUP -
GRUP 9,109,209 NEIN $ launching nose
LF 900 FAKG 1 BEZ 'Test G_1 X 0[m]'
ENDE

+PROG ASE URS:9
KOPF Test the system
$ step 1 dt 10 $ to test in case of instability
#define grplaun=1,2,3,4,5,9,101,102,103,104,105,109,201,202,203,204,205,209

let#s -242.00 ; TAKT GRP $(grplaun) XM 0 YM 0 PHI +#s/#R
GRUP -
GRUP 2,102,202 NEIN $ some superstructure construction phases
GRUP 3,103,203 NEIN $ some superstructure construction phases
GRUP 4,104,204 NEIN $ some superstructure construction phases
GRUP 5,105,205 NEIN $ some superstructure construction phases
LF 901 FAKG 1 BEZ 'Test phase 1 on bed s=#s[m]'
ENDE

let#s -190.00 ; TAKT GRP $(grplaun) XM 0 YM 0 PHI +#s/#R
GRUP -
GRUP 3,103,203 NEIN $ some superstructure construction phases
GRUP 4,104,204 NEIN $ some superstructure construction phases
GRUP 5,105,205 NEIN $ some superstructure construction phases
LF 902 FAKG 1 BEZ 'Test phase 2 on bed s=#s[m]'
ENDE

let#s -138.00 ; TAKT GRP $(grplaun) XM 0 YM 0 PHI +#s/#R
GRUP -
GRUP 4,104,204 NEIN $ some superstructure construction phases
GRUP 5,105,205 NEIN $ some superstructure construction phases
LF 903 FAKG 1 BEZ 'Test phase 3 on bed s=#s[m]'
ENDE

let#s -87.00 ; TAKT GRP $(grplaun) XM 0 YM 0 PHI +#s/#R
GRUP -
GRUP 5,105,205 NEIN $ some superstructure construction phases
LF 904 FAKG 1 BEZ 'Test phase 4 on bed s=#s[m]'
ENDE

let#s -49.00 ; TAKT GRP $(grplaun) XM 0 YM 0 PHI +#s/#R
GRUP -
LF 905 FAKG 1 BEZ 'Test phase 5 on bed s=#s[m]'
ENDE

+PROG CSM urs:7
KOPF Incremental launching
STEU KRAG 2
$ If you get instability, first activate the following STEU/CTRL ASE TEXT 'step 1 dt 10'
$ and check the activation of groups in the produced 4000-loadcases (animator)
$ CTRL ASE TEXT 'step 1 dt 10' $ to check instabilities during system-modelling !!!!!!!
$ You can also first check the launching with STEU/CTRL ASE TEXT 'STEU/CTRL SOLV 0'

TAKT GRP $(grplaun)  XM 0 YM 0 PHI 1 $ Definition of moving parts
sto#pos(1) -242.00 $ position for concreting phase 1 in launching bed
sto#pos(2) -190.00 $                               2
sto#pos(3) -138.00 $                               3
sto#pos(4)  -87.00 $                               4
sto#pos(5)  -49.00 $                               5
sto#pos(6)    0
sto#pos(7)    0
$
let#s #pos(1.00) ; let#print #s-#pos(1) ; BA 110 TYP G_1 BEZ 'launching s #print[m]' TAKT #s/#R[m] $ [m] because otherwise it is devided by 1000 (m/mm)
loop#i0 10
  let#s #pos(1.10+0.1*#i0) ; let#print #s-#pos(1) ; BA 111+#i0 TYP G_1 BEZ 'launching s #print[m]' TAKT #s/#R[m]
  let#s #pos(2.10+0.1*#i0) ; let#print #s-#pos(1) ; BA 121+#i0 TYP G_1 BEZ 'launching s #print[m]' TAKT #s/#R[m]
  let#s #pos(3.10+0.1*#i0) ; let#print #s-#pos(1) ; BA 131+#i0 TYP G_1 BEZ 'launching s #print[m]' TAKT #s/#R[m]
  let#s #pos(4.10+0.1*#i0) ; let#print #s-#pos(1) ; BA 141+#i0 TYP G_1 BEZ 'launching s #print[m]' TAKT #s/#R[m]
  let#s #pos(5.10+0.1*#i0) ; let#print #s-#pos(1) ; BA 151+#i0 TYP G_1 BEZ 'launching s #print[m]' TAKT #s/#R[m]
endloop
BA 200 TYP G_1 BEZ 'remove launching nose' TAKT 0
BA 210 TYP G_2 BEZ 'additional G_2'        TAKT 0

GRUP  NR        IBA1 WBIS   T0=7 PHIF=0.00
      -           1
    1,101,201     1
    2,102,202   120
    3,103,203   130
    4,104,204   140
    5,105,205   150
    9,109,209     1  160
LF 2 IBA1 210
STEU SPEI 0 ; SCAL AQ_S 0 $ no AQB check print
ENDE

+apply "$(NAME)_csm.dat"

<TEXT>
Hier hängen die Querschnitte des Vorbauschnabels von der Bezugsspur des Überbauquerschnittes weit nach unten.
Es werden zwei separate Verschubschienen an der Unterkante des Überbaus angekoppelt.
Die Ankopplung ist mit steifen Stäben ausgeführt, da der Verschub im Kreis erfolgt
und Kopplungen keine TAKT-Verdrehung mitmachen.
Der Nachteil dieser untenliegenden Hilfsschienen ist, dass auch das Einhängemoment im
Stabinneren aus einem Kontakt im Stabinneren nur unten an der Schiene eingehängt wird
und nicht im oberen Überbau, wo es dann für die Bemessung fehlt
 - also in diesem Fall kurze Stäbe verwenden!

</TEXT>

$ Bitte beachten Sie auch : CSM Handbuch:  Theoretische Grundlagen - Taktschieben Schulung

$ Dateiordner aufräumen:
+sys del $(project).$d?


