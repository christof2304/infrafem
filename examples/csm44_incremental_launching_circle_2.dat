let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(2.65) TYP 'S' GRP 4 NRQ 1 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(2.70) TYP 'S' GRP 4 NRQ 1 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(2.75) TYP 'S' GRP 4 NRQ 1 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(2.80) TYP 'S' GRP 4 NRQ 1 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(2.85) TYP 'S' GRP 4 NRQ 1 SPT #spt
sto#grpcs(3) #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(2.90) TYP 'S' GRP 3 NRQ 1 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(2.95) TYP 'S' GRP 3 NRQ 1 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(3.00) TYP 'S' GRP 3 NRQ 1 SPT #spt  $ 3. main bridge support at #S_XI(3)
sto#node(3) #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(3.05) TYP 'S' GRP 3 NRQ 1 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(3.10) TYP 'S' GRP 3 NRQ 1 SPT #spt
let#spt #spt+1 ; GAXP 'AX_1' S #s0+#S_XI(3.15) TYP 'S' GRP 3 NRQ 1 SPT #spt
